rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Productos: cualquiera puede leer, solo autenticados escriben
    match /productos/{productoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Usuarios: cualquier usuario autenticado puede leer/escribir su perfil
    match /usuarios/{userId} {
      allow read, write: if request.auth != null;
    }

    // Pedidos: cualquier usuario autenticado puede crear y leer
    match /pedidos/{pedidoId} {
      allow read, write: if request.auth != null;
    }

    // Reseñas: cualquiera puede leer, solo autenticados escriben
    match /resenas/{resenaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
