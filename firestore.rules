rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Productos: cualquiera puede leer y escribir (modo desarrollo)
    match /productos/{productoId} {
      allow read, write: if true;
    }

    // Usuarios: cualquier usuario autenticado puede leer/escribir su perfil
    match /usuarios/{userId} {
      allow read, write: if request.auth != null;
    }

    // Pedidos: cualquier usuario autenticado puede crear y leer
    match /pedidos/{pedidoId} {
      allow read, write: if request.auth != null;
    }
  }
}
